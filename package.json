{
  "name": "trustchain",
  "version": "0.1.0",
  "description": "Blockchain-based platform for decentralized identity, RBAC access control, and NFT-based digital asset management",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
