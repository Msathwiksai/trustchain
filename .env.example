# Copy to .env and fill in. .env is gitignored - never commit it, never paste a key into chat.

# RPC endpoint. Optional: defaults to a public Sepolia endpoint that needs no signup.
# Alchemy:  https://eth-sepolia.g.alchemy.com/v2/<your-key>
# Infura:   https://sepolia.infura.io/v3/<your-key>
SEPOLIA_RPC_URL=

# Deployer key, funded with Sepolia ETH. This account becomes the platform's root admin.
# Generate a throwaway one with `npm run wallet:new`, or export an account from MetaMask.
PRIVATE_KEY=

# Optional, only for `npm run verify:sepolia` (publishing source to Etherscan).
ETHERSCAN_API_KEY=
